# Paper keys from https://app.alpaca.markets (Paper account -> API keys)
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key
APCA_BASE_URL=https://paper-api.alpaca.markets
# iex (free) or sip (paid)
APCA_DATA_FEED=iex
# Required in addition to a live BASE_URL before any live order is sent
# ALLOW_LIVE_TRADING=yes
